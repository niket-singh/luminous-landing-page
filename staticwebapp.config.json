{
  "trailingSlash": "auto",
  "routes": [
    {
      "route": "/contact",
      "redirect": "/get-started",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/404.html",
    "exclude": ["/_next/*", "/*.{png,jpg,jpeg,svg,webp,ico,txt,xml,webmanifest,mp4}"]
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/404.html"
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "Referrer-Policy": "strict-origin-when-cross-origin"
  }
}
